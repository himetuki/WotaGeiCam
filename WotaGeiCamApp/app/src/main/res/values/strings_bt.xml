    <string name="bt_tip_settings_only">配对与连接请在系统蓝牙设置中完成</string>

    <!-- 音量与播控 -->
    <string name="bt_volume">媒体音量</string>
    <string name="bt_volume_value">%1$d%%</string>
    <string name="bt_play_pause">播放 / 暂停</string>
    <string name="bt_prev">上一曲</string>
    <string name="bt_next">下一曲</string>

    <!-- 状态提示 -->
    <string name="bt_grant">授予权限</string>
    <string name="bt_adapter_off">系统蓝牙未开启，请先在设置中打开</string>
</resources>
