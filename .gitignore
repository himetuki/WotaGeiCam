# =====================================================================
# WotaGeiCam 单树 monorepo（main 一棵树管两端）
#   Android/WotaGeiCamApp/     ← 安卓 Gradle 工程（分区细节见 Android/.gitignore）
#   HarmonyOS/WotaGeiCamOHOS/  ← 鸿蒙 DevEco 工程（见 HarmonyOS/.gitignore 与
#                                 HarmonyOS/WotaGeiCamOHOS/.gitignore）
# 分区细节由嵌套 .gitignore 负责；本文件只管：仓库根的本地资产目录、
# 跨分区构建产物与签名材料、IDE/临时类规则、交接文档。
# =====================================================================

# ===== 仓库根本地资产目录（工具/依赖/打包/记忆类，2026-10-22 晚自 Android/ 迁至根）=====
/tools/
/node_modules/
/docs/
/research/
/deliverable/
/agent-memory/
/camera-knowledge/
/baseline/
/.zcode/
.mimosa/
/package.json
/package-lock.json

# ===== 跨分区构建产物（各分区 .gitignore 另有细则）=====
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/
*.apk
*.aab
*.ap_
*.dex
*.class
*.hap
*.har
*.hsp

# ===== 仓库根 CI 暂存目录 =====
/apk-out/
/dist/

# ===== 签名材料（只留本机；CI 从 Actions Secrets 还原）=====
*.jks
*.keystore
# 鸿蒙签名材料扩展名，根级覆盖双端任意深度
*.p12
*.cer
*.p7b
*.csr
# 环境变量/密钥文件
.env
.env.*

# ===== HarmonyOS 兜底（细则在 HarmonyOS/.gitignore 与 WotaGeiCamOHOS/.gitignore；真实产物在 WotaGeiCamOHOS/ 层级下，故用 ** 深度无关写法）=====
/HarmonyOS/**/.hvigor/
/HarmonyOS/**/oh_modules/
/HarmonyOS/**/node_modules/
/HarmonyOS/**/.cxx/
/HarmonyOS/**/.pure-test-tmp/
/HarmonyOS/**/.local-signing/
/HarmonyOS/**/local.properties

# ===== IDE / 编辑器 =====
.idea/
*.iml
*.ipr
*.iws
.fleet/
.navigation/
.vscode/

# ===== 临时与缓存 =====
.tmp/
tmp/
*.log
*.bak
hs_err_pid*
replay_pid*
.DS_Store
Thumbs.db
desktop.ini

# ===== 交接文档（留在磁盘，不入版本库）=====
/Handover*.md

# ===== 会话临时取证（截图/UI 树 dump，不入版本库）=====
/.tmp/

# ===== 依赖锁与本机临时产物（不入版本库）=====
/docs/remained/
/HarmonyOS/**/*-lock.json5
/HarmonyOS/**/*.localbak*
/.*.json
